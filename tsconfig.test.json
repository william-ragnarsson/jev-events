{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "customConditions": [
      "source"
    ]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "examples/*/**/*.ts",
    "evals/**/*.ts",
    "apps/live-relay/src/**/*.ts",
    "apps/live-relay/test/**/*.ts",
    "scripts/**/*.ts",
    "apps/web/test/**/*.ts",
    "apps/web/snippets/**/*.ts",
    "smoke/**/*.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**"
  ]
}
