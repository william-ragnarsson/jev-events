# Copy this file to .env, which git ignores. Fill in what the script you run needs.

# Every script except google-token. Get a key at https://docs.typesafe.ai/introduction/quickstart
TYPESAFE_API_KEY=

# slack.ts. Run `npm run slack` without these and it prints a link that makes the Slack app.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# gmail.ts and calendar.ts. The ID and secret come from Google's console (see README.md),
# and `npm run google-token` prints the refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
