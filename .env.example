# Copy this file to .env, which git ignores. Only the key is required.

# Your TypeSafe API key: https://docs.typesafe.ai/introduction/quickstart
TYPESAFE_API_KEY=

# Optional. `npm run cli -- auth google` and `auth slack` ask for these and save them for you.
# Set them here instead to skip the questions.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
